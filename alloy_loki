name: fetch-images
on:
  workflow_dispatch:

jobs:
  export:
    runs-on: ubuntu-latest
    steps:
      - name: Pull images
        run: |
          docker pull grafana/loki:3.5.1
          docker pull grafana/alloy:v1.10.0

      - name: Save images to tar
        run: |
          docker save grafana/loki:3.5.1 -o loki_3.5.1.tar
          docker save grafana/alloy:v1.10.0 -o alloy_v1.10.0.tar

      - name: Upload artifacts
        uses: actions/upload-artifact@v4
        with:
          name: docker-images
          path: |
            loki_3.5.1.tar
            alloy_v1.10.0.tar
